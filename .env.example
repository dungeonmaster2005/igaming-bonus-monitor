# Copy to .env and fill in. Never commit .env.

# Google Sheets — set ONE of the two credential variables:
# local: path to the service-account JSON file
GOOGLE_CREDS_PATH=./google-creds.json
# CI: the whole service-account JSON as a single string
GOOGLE_CREDS=
SHEET_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
LOG_LEVEL=INFO
